# EduPulse Environment Variables
# Copy this file to .env and fill in values
#
# All settings are optional at runtime except where noted.
# The application falls back to sensible defaults for everything else.

# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

# Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# GitHub repository (owner/repo) — used by Workload Identity Federation
GITHUB_REPO=owner/your-repo

# ---------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------

# AI model used by all agents (override per deployment)
EDUPULSE_MODEL=gemini-3.5-flash-lite

# Per-agent model overrides — set only the ones you want to specialize.
# Each agent has its own independent default (gemini-3.5-flash-lite).
EDUPULSE_MODEL_STUDENT=gemini-3.5-flash-lite
EDUPULSE_MODEL_RISK_PREDICTOR=gemini-2.5-pro
EDUPULSE_MODEL_COURSE_RECOMMENDER=gemini-3.5-flash-lite
EDUPULSE_MODEL_FINANCIAL_AID=gemini-3.5-flash-lite
EDUPULSE_MODEL_ADVISOR=gemini-3.5-flash-lite
EDUPULSE_MODEL_ADMIN=gemini-2.5-pro

# GCP region for all regional resources
REGION=us-east1

# BigQuery dataset names
BIGQUERY_DATASET_STUDENT=edupulse_student_data
BIGQUERY_DATASET_ANALYTICS=edupulse_analytics

# Firestore collection names
FIRESTORE_COLLECTION_ENGAGEMENT=student_engagement
FIRESTORE_COLLECTION_SESSIONS=student_sessions
FIRESTORE_COLLECTION_ALERTS=active_alerts
FIRESTORE_COLLECTION_ADVISOR_NOTES=advisor_notes

# AgentOps API Key (get from https://app.agentops.ai) — enables session replays
AGENTOPS_API_KEY=your-agentops-api-key

# Model Armor Configuration (LLM security)
MODEL_ARMOR_PROJECT_ID=your-gcp-project-id        # Defaults to PROJECT_ID
MODEL_ARMOR_LOCATION=us-east1
MODEL_ARMOR_TEMPLATE_ID=edupulse-model-armor-template # created using the Terraform scripts
